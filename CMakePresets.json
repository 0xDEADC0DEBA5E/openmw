{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-gcc16",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CMAKE_SYSTEM_NAME": "Linux"
      }
    },
    {
      "name": "linux-gcc16-debug",
      "displayName": "Linux GCC 16 Debug",
      "inherits": "linux-gcc16",
      "binaryDir": "${sourceDir}/out/build/linux/gcc16-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-gcc16-release",
      "displayName": "Linux GCC 16 Release",
      "inherits": "linux-gcc16",
      "binaryDir": "${sourceDir}/out/build/linux/gcc16-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-gcc16",
      "hidden": true,
      "generator": "Ninja",
      "vendor": {
        "jetbrains.com/clion": { "toolchain": "MinGW" }
      },
      "environment": {
        "GCC16_BIN": "C:/msys64/mingw64/bin",
        "PATH": "$env{GCC16_BIN};$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows"
      }
    },
    {
      "name": "windows-gcc16-debug",
      "displayName": "Windows GCC 16 Debug",
      "inherits": "windows-gcc16",
      "binaryDir": "${sourceDir}/out/build/windows/gcc16-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-gcc16-release",
      "displayName": "Windows GCC 16 Release",
      "inherits": "windows-gcc16",
      "binaryDir": "${sourceDir}/out/build/windows/gcc16-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "linux-gcc16-debug", "configurePreset": "linux-gcc16-debug" },
    { "name": "linux-gcc16-release", "configurePreset": "linux-gcc16-release" },
    { "name": "windows-gcc16-debug", "configurePreset": "windows-gcc16-debug" },
    { "name": "windows-gcc16-release", "configurePreset": "windows-gcc16-release" }
  ]
}
